
const express = require("express");

const app = express();
app.use(express.json({ limit: "10mb" }));

const PORT = process.env.PORT || 3000;
const GEMINI_API_KEY = process.env.GEMINI_API_KEY;

app.get("/health", (req, res) => {
  res.json({
    ok: true,
    service: "ViralStudio IA API",
    geminiConfigured: Boolean(GEMINI_API_KEY)
  });
});

app.post("/api/generate-plan", async (req, res) => {
  try {
    if (!GEMINI_API_KEY) {
      return res.status(503).json({
        error: "Gemini todavía no está configurado en el servidor."
      });
    }

    const { idea, duration, format, style } = req.body || {};

    if (!idea || !String(idea).trim()) {
      return res.status(400).json({
        error: "Escribe una idea para tu video."
      });
    }

    const prompt = `
Eres el guionista experto de ViralStudio IA.
Responde en español y crea un plan original para un video corto
atractivo, claro y fácil de producir.

Idea: ${String(idea).slice(0, 3000)}
Duración: ${String(duration || "30 segundos").slice(0, 100)}
Formato: ${String(format || "Vertical 9:16").slice(0, 100)}
Estilo: ${String(style || "Cinematográfico").slice(0, 200)}

Incluye:
1. Un título llamativo.
2. Un gancho para los primeros 3 segundos.
3. Escenas ordenadas con duración, imagen, movimiento de cámara,
   narración o texto en pantalla y sonido.
4. Un cierre memorable y una llamada a la acción.
5. Un prompt visual para generar el video.

No afirmes que el video ya fue generado. Entrega solo el plan.
`;

    const response = await fetch(
      "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-goog-api-key": GEMINI_API_KEY
        },
        body: JSON.stringify({
          contents: [
            {
              parts: [{ text: prompt }]
            }
          ],
          generationConfig: {
            temperature: 0.8,
            maxOutputTokens: 1800
          }
        })
      }
    );

    const data = await response.json();

    if (!response.ok) {
      console.error("Error de Gemini:", response.status, data);
      return res.status(502).json({
        error: "Gemini no pudo generar el plan. Revisa la configuración de la API."
      });
    }

    const plan = (data.candidates || [])
      .flatMap(candidate => candidate.content?.parts || [])
      .map(part => part.text || "")
      .join("\n")
      .trim();

    if (!plan) {
      return res.status(502).json({
        error: "Gemini devolvió una respuesta vacía. Intenta otra vez."
      });
    }

    res.json({ ok: true, plan });
  } catch (error) {
    console.error("Error interno:", error);
    res.status(500).json({
      error: "Ocurrió un error al preparar el plan."
    });
  }
});

app.listen(PORT, () => {
  console.log(`ViralStudio IA API funcionando en el puerto ${PORT}`);
});
